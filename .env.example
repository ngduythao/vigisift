DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/vigisift
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=vigisift
MQTT_PASSWORD=vigisift
ASSISTANT_ENABLED=false
# ollama | anthropic
ASSISTANT_PROVIDER=ollama
# Keep these the same model as Frigate's genai.local.model (deploy/frigate/config.template.yml),
# so Ollama holds one copy. Default: DEFAULT_VLM_MODEL in src/vigisift/config.py.
OLLAMA_MODEL=qwen3-vl:8b-instruct
RULE_CHECK_MODEL=qwen3-vl:8b-instruct
# Only for ASSISTANT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Days kept: unjudged alerts, LLM calls, telemetry, finished commands; judged alerts (eval labels).
RETENTION_DAYS=90
REVIEWED_RETENTION_DAYS=365
